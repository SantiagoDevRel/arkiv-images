{
  "name": "arkiv-images",
  "version": "1.0.0",
  "description": "Store public PNG and JPEG images as Arkiv entities and retrieve verified original bytes.",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "AGENTS.md",
    "CLAUDE.md",
    "sample/README.md",
    "sample/AGENTS.md",
    "sample/CLAUDE.md",
    "LICENSE",
    "docs/verification.md",
    "docs/rabdi-evidence.json",
    "CHANGELOG.md"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=22.10.0"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SantiagoDevRel/arkiv-images.git"
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "lint": "node scripts/lint.mjs",
    "test": "npm run build && node --test test/*.test.mjs",
    "test:browser": "node test/browser-smoke.mjs",
    "prepack": "npm run build"
  },
  "dependencies": {
    "arkiv-chunking": "1.1.0"
  },
  "peerDependencies": {
    "@arkiv-network/sdk": "^1.0.0",
    "viem": "^2.56.3"
  },
  "devDependencies": {
    "@arkiv-network/sdk": "1.0.0",
    "@types/node": "22.19.13",
    "playwright": "1.62.1",
    "typescript": "5.9.3",
    "viem": "2.56.3"
  }
}
